# Application
APP_NAME=StackView
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS
CORS_ORIGINS=*

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE=app.log
REQUEST_LOG_FILE=requests.log

# File-backed runtime data (rate limit)
DATA_DIR=data

# Database
DB_NAME=stackview_db
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
#DB_HOST=db
DB_PORT=5432

# Rate limiting
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# SMTP
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# MAIL_FROM=noreply@example.com
# MAIL_TO_OWNER=owner@example.com

# OpenAI
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=15
AI_ENABLED=true
