# Application
APP_NAME=StackView
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS — comma-separated origins, or * for all
CORS_ORIGINS=*

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE=app.log
REQUEST_LOG_FILE=requests.log

# File-backed runtime data (rate limit, etc.)
DATA_DIR=data

# Database (optional in Stage 0; required later for submissions/metrics)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/stackview

# Rate limiting
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# SMTP (Stage 2)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# MAIL_FROM=noreply@example.com
# MAIL_TO_OWNER=owner@example.com

# OpenAI (Stage 3)
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=15
AI_ENABLED=true
